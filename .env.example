# Local testing only. Production must supply its own secret and real Firebase/R2.
ENV=development
PORT=8080
JWT_SECRET=local-development-only-jwt-secret-minimum-32-characters
LOCAL_TEST_ACCOUNTS=true
LOCAL_STORAGE=true
LOCAL_STORAGE_DIR=.local-media
DB_HOST=localhost
DB_PORT=5432
DB_USER=bikko
DB_PASSWORD=bikkopass
DB_NAME=bikkodb
DB_SSLMODE=disable
REDIS_HOST=localhost
REDIS_PORT=6379
